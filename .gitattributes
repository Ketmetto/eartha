# Force LF for anything that runs inside a Linux container or shell,
# regardless of what OS a contributor commits from — a CRLF shebang line
# (e.g. `#!/bin/sh\r`) fails with "bad interpreter" in the container.
* text=auto eol=lf

*.sh text eol=lf
*.py text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary — never touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg binary
*.ico binary
