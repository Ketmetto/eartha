DJANGO_SECRET_KEY=change-me
DJANGO_SETTINGS_MODULE=config.settings.dev
DEBUG=True
# Only read outside dev.py, which hardcodes ["*"] regardless of this value
# — but prod.py/staging.py have no such fallback, so an empty/missing
# value there means Django rejects every request with DisallowedHost.
ALLOWED_HOSTS=YOURDOMAIN.com,www.YOURDOMAIN.com

POSTGRES_DB=eartha
POSTGRES_USER=eartha
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=

# SendGrid SMTP relay: EMAIL_HOST_USER is literally the string "apikey" (not
# an address); EMAIL_HOST_PASSWORD is your SendGrid API key (Mail Send scope).
# DEFAULT_FROM_EMAIL must be a sender you've verified in SendGrid (Settings ->
# Sender Authentication) or SendGrid will reject the send.
EMAIL_HOST=smtp.sendgrid.net
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
DEFAULT_FROM_EMAIL=

CORS_ALLOWED_ORIGINS=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_KEY_ID=
APPLE_CALLBACK_URL=

# Firebase Auth (Google/Apple social login). FIREBASE_SERVICE_ACCOUNT_JSON must
# be the service-account key minified to a single line, e.g.:
#   python -c "import json;print(json.dumps(json.load(open('key.json'))))"
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Google Maps Platform — Places Autocomplete on the pickup-address fields
# (upload + profile settings). Needs the "Places API" enabled in Google
# Cloud Console, and an HTTP-referrer restriction on the key (it's used
# client-side, so it's not a secret, but restrict it anyway). Blank is
# fine — the address fields just stay plain text inputs.
GOOGLE_MAPS_API_KEY=

# Error tracking (prod.py/staging.py only) — blank means it's a no-op.
SENTRY_DSN=
